#!/bin/bash
# 更新系統套件庫並安裝 Java 21 與 wget
sudo apt update
sudo apt install -y openjdk-21-jre-headless wget

# 下載 NeoForge 1.21.1 安裝檔
wget -O neoforge-installer.jar https://maven.neoforged.net/releases/net/neoforged/neoforge/21.1.80/neoforge-21.1.80-installer.jar

# 執行伺服器端建置
java -jar neoforge-installer.jar --installServer

# 清理安裝檔
rm neoforge-installer.jar

# 同意 EULA 條款
echo "eula=true" > eula.txt
